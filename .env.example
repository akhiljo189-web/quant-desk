# Market data, news, and the options tape
POLYGON_API_KEY=your_polygon_key_here

# The PEAD trigger's data source. Not a key — the SEC requires a contact
# address on every request and blocks anonymous traffic. Seven-plus years of
# quarterly EPS come from here, free, and the exact announcement instant from
# the item-2.02 8-K acceptance time.
SEC_USER_AGENT=your_name your_email@example.com

# Optional. Consensus surprise, for cross-checking SUE against the analyst
# definition. The free tier returns four quarters, far too few to drive a
# walk-forward — see HYPOTHESIS.md.
FINNHUB_API_KEY=your_finnhub_key_here

# Broker (paper endpoint by default; live is gated by qd/gate.py)
ALPACA_KEY_ID=your_alpaca_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# paper | live | replay
QD_MODE=paper

# Optional overrides — defaults live in qd/config.py
# QD_SYMBOLS=AAPL,MSFT,NVDA
# QD_RISK_PCT=0.5
# QD_MAX_POSITIONS=8
# QD_DAILY_STOP_PCT=2.0
# QD_WEEKLY_STOP_PCT=4.0
# QD_MIN_SOURCES=2
# QD_MIN_CONVICTION=0.35
# QD_ALLOW_OVERNIGHT=true
# QD_PDT_ENFORCE=true

# Delayed data tiers are fine for this strategy (PEAD is a multi-day
# drift, not a speed race), but the staleness watchdog must know the
# delay or it halts every entry. Default assumes 15 minutes.
# QD_FEED_DELAY_MINUTES=15
